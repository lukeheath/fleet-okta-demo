      "e6915fb7-9eb5-4cd3-a0f2-79d2930a01d3": {
        "id": "e6915fb7-9eb5-4cd3-a0f2-79d2930a01d3",
        "name": "Restore if compliant",
        "description": "Release one quarantined user if their Mac passes every policy in gating_policies. Fails closed: an empty login, no matching Fleet host, or a gating policy that is failing or missing from the host's results, keeps the user in Quarantine. gating_policies must list exactly the Fleet policies with webhooks_and_tickets_enabled: true (tools/validate-flopack checks this).",
        "data": {
          "id": null,
          "uuid": "e6915fb7-9eb5-4cd3-a0f2-79d2930a01d3",
