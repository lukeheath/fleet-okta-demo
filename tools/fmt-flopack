#!/usr/bin/env python3
"""Rewrite .flopack files in canonical form (2-space JSON, key order preserved).

Usage: tools/fmt-flopack [--stdout] FILE...
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from flopack.fmt import format_text  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--stdout", action="store_true")
    ap.add_argument("files", nargs="+", type=pathlib.Path)
    args = ap.parse_args()
    for path in args.files:
        text = format_text(json.loads(path.read_text()))
        if args.stdout:
            sys.stdout.write(text)
        else:
            path.write_text(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
